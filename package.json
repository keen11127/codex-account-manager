{
  "name": "codex-account-manager",
  "version": "0.4.1",
  "private": true,
  "author": "Local Codex Tools",
  "license": "MIT",
  "homepage": "https://github.com/keen11127/codex-account-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keen11127/codex-account-manager.git"
  },
  "bugs": {
    "url": "https://github.com/keen11127/codex-account-manager/issues"
  },
  "description": "Local Windows desktop manager for multiple Codex accounts, usage limits, and reset credits.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.72.5",
    "@fluentui/react-icons": "^2.0.310",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.local.codexaccountmanager",
    "productName": "Codex Account Manager",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "prompt-templates/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  }
}
